<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.pd_pro_biblioteka_client.controller.Addbookmodal"
      prefWidth="250" prefHeight="150" alignment="CENTER" spacing="20"
      style="-fx-padding: 20; -fx-background-color: #726C6C;">

    <Button text="Dodaj autora" onAction="#onDodajAutora" style="-fx-font-size: 14px; -fx-background-radius: 10; -fx-background-color: #2C2C2C; -fx-text-fill: #F5F5F5"/>
    <Button text="Dodaj książkę" onAction="#onDodajKsiazke" style="-fx-font-size: 14px; -fx-background-radius: 10; -fx-background-color: #2C2C2C; -fx-text-fill: #F5F5F5"/>
</VBox>