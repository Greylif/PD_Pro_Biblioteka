<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<AnchorPane prefHeight="1000.0" prefWidth="1000.0" style="-fx-background-color: #726C6C;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pd_pro_biblioteka_client.controller.Client">

    <!-- TabPane zajmuje całą powierzchnię -->
    <TabPane fx:id="tabPane" style="-fx-background-color: #726C6C;" tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <Tab style="-fx-background-color: #2C2C2C; -fx-text-base-color: #F5F5F5;" text="Książki">
            <HBox alignment="TOP_CENTER" spacing="30">
                <TableView fx:id="serachTable" editable="true" prefHeight="1000.0" prefWidth="900.0" style="-fx-background-color: #726C6C; -fx-text-fill: #F5F5F5; -fx-table-cell-border-color: #2C2C2C">
                    <columns>
                        <TableColumn fx:id="s_ID" prefWidth="100" style="-fx-text-fill: #2C2C2C;" text="ID" />
                        <TableColumn fx:id="s_title" prefWidth="300" style="-fx-text-fill: #2C2C2C;" text="Tytuł" />
                        <TableColumn fx:id="s_autor" prefWidth="300" style="-fx-text-fill: #2C2C2C;" text="Autor" />
                        <TableColumn fx:id="s_ID_autor" prefWidth="100" style="-fx-text-fill: #2C2C2C;" text="ID autora" />
                        <TableColumn fx:id="s_borrow" prefWidth="100" style="-fx-text-fill: #2C2C2C;" text="Wypożyczone" />
                    </columns>
                </TableView>
            </HBox>
        </Tab>

        <Tab style="-fx-background-color: #2C2C2C; -fx-text-base-color: #F5F5F5;" text="Filtry">
            <VBox alignment="CENTER_LEFT" spacing="30">
                <VBox alignment="CENTER_LEFT" spacing="30">
                    <Label style="-fx-font-size: 16px; -fx-text-fill: #F5F5F5" text="Filtr:" />
                    <HBox spacing="10">
                        <ComboBox fx:id="f_combo1" prefWidth="200"/>
                        <TextField fx:id="f_search1" prefWidth="600" style="-fx-font-size: 13px;" />
                    </HBox>
                    <HBox spacing="10">
                        <ComboBox fx:id="f_combo2" prefWidth="200"/>
                        <TextField fx:id="f_search2" prefWidth="600" style="-fx-font-size: 13px;" />
                    </HBox>
                    <Button fx:id="borrow_button" onAction="#filtr_button" style="-fx-font-size: 16px; -fx-background-radius: 20px; -fx-border-radius: 20px; -fx-background-color: #2C2C2C; -fx-text-fill: #F5F5F5" text="Zatwierdź" />
                    <Region prefHeight="0" />
                </VBox>
                <HBox>
                    <TableView fx:id="fitrTable" prefHeight="1000.0" style="-fx-background-color: #726C6C; -fx-text-fill: #F5F5F5; -fx-table-cell-border-color: #2C2C2C">
                        <columns>
                            <TableColumn fx:id="f_id_book" prefWidth="100" style="-fx-text-fill: #2C2C2C;" text="ID Książki" />
                            <TableColumn fx:id="f_title" prefWidth="300" style="-fx-text-fill: #2C2C2C;" text="Tytul" />
                            <TableColumn fx:id="f_id_autor" prefWidth="100" style="-fx-text-fill: #2C2C2C;" text="ID Książki" />
                            <TableColumn fx:id="f_autor" prefWidth="200" style="-fx-text-fill: #2C2C2C;" text="Autor" editable="false" />
                            <TableColumn fx:id="f_genre" prefWidth="200" style="-fx-text-fill: #2C2C2C;" text="Gatunek" editable="false" />
                            <TableColumn fx:id="f_year" prefWidth="150" style="-fx-text-fill: #2C2C2C;" text="Rok wydania" editable="false" />
                            <TableColumn fx:id="f_id_place" prefWidth="150" style="-fx-text-fill: #2C2C2C;" text="ID placówki" editable="false" />
                        </columns>
                    </TableView>
                </HBox>
            </VBox>
        </Tab>

        <Tab style="-fx-background-color: #2C2C2C; -fx-text-base-color: #F5F5F5;" text="Wypożyczenia">
            <HBox alignment="TOP_CENTER" spacing="30">
                <TableView fx:id="borrowTable" prefHeight="1200.0" style="-fx-background-color: #726C6C; -fx-text-fill: #F5F5F5; -fx-table-cell-border-color: #2C2C2C">
                    <columns>
                        <TableColumn fx:id="b_id" prefWidth="100" style="-fx-text-fill: #2C2C2C;" text="ID" />
                        <TableColumn fx:id="b_title" prefWidth="338.0" style="-fx-text-fill: #2C2C2C;" text="Tutuł" />
                        <TableColumn fx:id="b_autor" prefWidth="316.0" style="-fx-text-fill: #2C2C2C;" text="Autor" />
                        <TableColumn fx:id="borrow_date" prefWidth="377" style="-fx-text-fill: #2C2C2C;" text="Data wypożyczenia" />
                        <TableColumn fx:id="return_date" prefWidth="379.0" style="-fx-text-fill: #2C2C2C;" text="Data oddania" />
                    </columns>
                </TableView>
            </HBox>
        </Tab>

        <Tab style="-fx-background-color: #2C2C2C; -fx-text-base-color: #F5F5F5;" text="Kary">
            <HBox alignment="CENTER" spacing="10">
                <TableView fx:id="penaltyTable" prefHeight="971.0" prefWidth="1653.0" style="-fx-background-color: #726C6C; -fx-text-fill: #F5F5F5; -fx-table-cell-border-color: #2C2C2C">
                    <columns>
                        <TableColumn fx:id="p_id" prefWidth="131.0" style="-fx-text-fill: #2C2C2C;" text="ID kary" />
                        <TableColumn fx:id="p_userid" prefWidth="168.0" style="-fx-text-fill: #2C2C2C;" text="ID użytkownika" />
                        <TableColumn fx:id="p_desc" prefWidth="464.0" style="-fx-text-fill: #2C2C2C;" text="Tytuł kary" />
                        <TableColumn fx:id="p_date" prefWidth="247.0" style="-fx-text-fill: #2C2C2C;" text="Data wydania" />
                        <TableColumn fx:id="p_payment_date" prefWidth="217.0" style="-fx-text-fill: #2C2C2C;" text="Termin do zapłaty" />
                        <TableColumn fx:id="p_value" prefWidth="179.0" style="-fx-text-fill: #2C2C2C;" text="Wartość kary" />
                        <TableColumn fx:id="p_status" prefWidth="249.0" style="-fx-text-fill: #2C2C2C;" text="Opłacono" />
                    </columns>
                </TableView>
            </HBox>
        </Tab>

        <Tab style="-fx-background-color: #2C2C2C; -fx-text-base-color: #F5F5F5;" text="Ustawienia konta">
            <VBox alignment="TOP_CENTER" spacing="10" style="-fx-padding: 20;">
                <Region prefHeight="0" />
                <HBox spacing="50">
                    <VBox alignment="CENTER_LEFT" spacing="5">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: #F5F5F5" text="Imię" />
                        <TextField fx:id="user_name" prefWidth="300" style="-fx-font-size: 16px;" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" spacing="5">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: #F5F5F5" text="Nazwisko" />
                        <TextField fx:id="user_surname" prefWidth="300" style="-fx-font-size: 16px;" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" spacing="5">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: #F5F5F5" text="ID" />
                        <TextField fx:id="user_ID" editable="false" prefWidth="300" style="-fx-font-size: 16px;" />
                    </VBox>

                </HBox>

                <Region prefHeight="20" />

                <HBox alignment="CENTER_LEFT" spacing="5">
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: #F5F5F5" text="Data urodzenia" />
                        <TextField fx:id="user_date" prefHeight="35.0" prefWidth="800.0" style="-fx-font-size: 16px;" />
                    </VBox>
                </HBox>

                <Region prefHeight="20" />

                <HBox alignment="CENTER_LEFT" spacing="5">
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: #F5F5F5" text="E-Mail" />
                        <TextField fx:id="user_email" prefWidth="800" style="-fx-font-size: 16px;" />
                    </VBox>
                </HBox>

                <Region prefHeight="20" />

                <HBox alignment="CENTER_LEFT" spacing="5">
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: #F5F5F5" text="Login" />
                        <TextField fx:id="user_login" prefWidth="800" style="-fx-font-size: 16px;" />
                    </VBox>
                </HBox>

                <Region prefHeight="20" />

                <HBox alignment="CENTER_LEFT" spacing="5">
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: #F5F5F5" text="Hasło" />
                        <PasswordField fx:id="user_password" prefWidth="800" style="-fx-font-size: 16px;" />
                        <TextField fx:id="textField" editable="false" managed="false" prefWidth="800" promptText="Hasło" style="-fx-font-size: 16px;" visible="false" />
                        <CheckBox fx:id="showPassword" onAction="#togglePasswordVisibility" text="Pokaż hasło" />
                    </VBox>
                </HBox>

                <Region prefHeight="20" />
                <HBox spacing="10">
                    <Button fx:id="2FA_button" onAction="#on2FA" style="-fx-font-size: 16px; -fx-background-radius: 20px; -fx-border-radius: 20px;                        -fx-background-color: #2C2C2C; -fx-text-fill: #F5F5F5" text="Włącz składnik 2-etapowy" />
                    <Region prefHeight="20" />
                    <Button fx:id="save_button" onAction="#save" style="-fx-font-size: 16px; -fx-background-radius: 20px; -fx-border-radius: 20px;                        -fx-background-color: #2C2C2C; -fx-text-fill: #F5F5F5" text="Zapisz zmiany" />
                    <Region prefHeight="20" />
                    <Button fx:id="del_button" onAction="#delete_acc" style="-fx-font-size: 16px; -fx-background-radius: 20px; -fx-border-radius: 20px;                        -fx-background-color: #2C2C2C; -fx-text-fill: #F5F5F5" text="Usuń konto" />
                </HBox>
            </VBox>
        </Tab>
    </TabPane>

    <Button fx:id="test" layoutX="1810" layoutY="2" onAction="#logout" style="-fx-font-size: 12px; -fx-background-radius: 10px; -fx-border-radius: 10px;                    -fx-background-color: #2C2C2C; -fx-text-fill: #F5F5F5" text="Wyloguj się" />
    <Button fx:id="refr_button" layoutX="1710" layoutY="2" onAction="#refresh" style="-fx-font-size: 12px; -fx-background-radius: 10px; -fx-border-radius: 10px; -fx-background-color: #2C2C2C; -fx-text-fill: #F5F5F5" text="Odśwież" />

</AnchorPane>
