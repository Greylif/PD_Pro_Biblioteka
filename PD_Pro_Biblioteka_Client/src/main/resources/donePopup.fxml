<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<VBox fx:id="donePopup" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.pd_pro_biblioteka_client.controller.donePopup"
      alignment="CENTER" spacing="20"
      style="-fx-padding: 20; -fx-background-color: #726C6C;">

<Label text="Operacja wykonana POMYŚLNIE!" style="-fx-font-size: 18px; -fx-text-fill: #FFFFFF;"/>

<Button fx:id="exit" text="Zamknij" onAction="#closePopup"
        style="-fx-font-size: 14px; -fx-background-radius: 10; -fx-background-color: #2C2C2C; -fx-text-fill: #F5F5F5"/>

</VBox>
