<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="setup_totp" prefHeight="600.0" prefWidth="600.0" style="-fx-background-color: #726C6C; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pd_pro_biblioteka_client.controller.SetupTotp">
    <Region prefHeight="20" />

    <Label style="-fx-font-size: 32px; -fx-text-fill: #FFFFFF" text="Konfiguracja 2FA (TOTP)" />

    <Region prefHeight="30" />

    <Label prefHeight="44.0" prefWidth="608.0" style="-fx-font-size: 16px; -fx-text-fill: #F5F5F5;" text="Zeskanuj ten kod QR w aplikacji (np. Google Authenticator)" wrapText="true" />

    <Region prefHeight="20" />

    <ImageView fx:id="qrCodeImage" fitHeight="200" fitWidth="200" preserveRatio="true" />

    <Label fx:id="qrCodeSecret" text="Token:" style="-fx-text-fill: #F5F5F5;"/>

    <Region prefHeight="30" />

    <HBox alignment="CENTER_LEFT">
        <Label style="-fx-font-size: 16px; -fx-text-fill: #F5F5F5" text="Wprowadź kod z aplikacji:" />
    </HBox>
    <TextField fx:id="totpCodeField" prefHeight="20" promptText="Np. 123456" style="-fx-font-size: 18px;" />


    <Region prefHeight="30" />

    <HBox alignment="CENTER" spacing="20">
        <Button fx:id="confirmButton" onAction="#onConfirmClicked" style="-fx-font-size: 14px; -fx-background-radius: 10px; -fx-border-radius: 10px;                        -fx-padding: 10px 20px; -fx-background-color: #2C2C2C; -fx-text-fill: #F5F5F5" text="Zatwierdź" />
        <Button fx:id="cancelButton" onAction="#onCancelClicked" style="-fx-font-size: 14px; -fx-background-radius: 10px; -fx-border-radius: 10px;                        -fx-padding: 10px 20px; -fx-background-color: #726C6C; -fx-text-fill: #2C2C2C" text="Anuluj" />
    </HBox>

    <Region prefHeight="50" />

    <Label fx:id="infoLabel" style="-fx-font-size: 14px;" textFill="red" wrapText="true" />
</VBox>
