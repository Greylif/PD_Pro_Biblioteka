<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:id="loginbox" xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.pdprobibliotekaclient.controller.Login"
      alignment="TOP_CENTER" style="-fx-background-color: #726C6C; -fx-padding: 20;" prefHeight="600.0" prefWidth="600.0">

    <Region prefHeight="20"/>

    <Label text="Logowanie:" style="-fx-font-size: 32px; -fx-text-fill: #FFFFFF"/>

    <Region prefHeight="130"/>

    <HBox alignment="CENTER_LEFT">
        <Label text="Email/Login"  style="-fx-font-size: 16px; -fx-text-fill: #F5F5F5"/>
    </HBox>
    <TextField fx:id="userlogin" prefHeight="20" style="-fx-font-size: 18px;"/>

    <Region prefHeight="30"/>

    <HBox alignment="CENTER_LEFT">
        <Label text="2FA (Jeśli nie zostało aktywowane - pozostawić puste)" style="-fx-font-size: 16px; -fx-text-fill: #F5F5F5"/>
    </HBox>
    <TextField fx:id="twoFA" prefHeight="20" style="-fx-font-size: 18px;"/>

    <Region prefHeight="30"/>

    <HBox alignment="CENTER_LEFT">
        <Label text="Hasło" style="-fx-font-size: 16px; -fx-text-fill: #F5F5F5"/>
    </HBox>
    <PasswordField fx:id="userpass" prefHeight="20" style="-fx-font-size: 18px;"/>

    <Region prefHeight="50"/>

    <HBox alignment="CENTER" spacing="20">
        <Button fx:id="login" text="Zaloguj" onAction="#loginact"
                style="-fx-font-size: 14px; -fx-background-radius: 10px; -fx-border-radius: 10px; -fx-padding: 10px 20px; -fx-arc-width: 20px; -fx-background-color: #2C2C2C; -fx-text-fill: #F5F5F5"/>
        <Button fx:id="login_a" text="ADMIN" onAction="#loginactadm"
                style="-fx-font-size: 14px; -fx-background-radius: 10px; -fx-border-radius: 10px; -fx-padding: 10px 20px; -fx-arc-width: 20px; -fx-background-color: #2C2C2C; -fx-text-fill: #F5F5F5"/>
        <Button fx:id="register" text="Zarejestruj" onAction="#registeract"
                style="-fx-font-size: 14px; -fx-background-radius: 10px; -fx-border-radius: 10px; -fx-padding: 10px 20px; -fx-arc-width: 20px; -fx-background-color: #726C6C; -fx-text-fill: #2C2C2C"/>
    </HBox>

    <Region prefHeight="150"/>

    <Button fx:id="pass_rem" text="Zapomniałeś hasła?" onAction="#remact"
            style="-fx-font-size: 14px; -fx-background-radius: 10px; -fx-border-radius: 10px; -fx-padding: 10px 20px; -fx-arc-width: 20px; -fx-background-color: #726C6C; -fx-text-fill: #2C2C2C; -fx-underline: true"/>

</VBox>