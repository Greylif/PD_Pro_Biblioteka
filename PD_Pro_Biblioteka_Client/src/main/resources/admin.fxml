<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="1000.0" prefWidth="1000.0" style="-fx-background-color: #726C6C;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.pd_pro_biblioteka_client.controller.Admin">

    <!-- TabPane zajmuje całą powierzchnię -->
    <TabPane fx:id="tabPane" style="-fx-background-color: #726C6C;" tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <Tab style="-fx-background-color: #2C2C2C; -fx-text-base-color: #F5F5F5;" text="Książki">
            <HBox alignment="TOP_CENTER" spacing="30">
                <TableView fx:id="serachTable" prefHeight="1000.0" prefWidth="1250.0" style="-fx-background-color: #726C6C; -fx-text-fill: #F5F5F5; -fx-table-cell-border-color: #2C2C2C">
                    <columns>
                        <TableColumn fx:id="s_title" prefWidth="300" style="-fx-text-fill: #2C2C2C;" text="Tytuł" />
                        <TableColumn fx:id="s_autor" prefWidth="300" style="-fx-text-fill: #2C2C2C;" text="Autor" />
                        <TableColumn fx:id="s_genre" prefWidth="300" style="-fx-text-fill: #2C2C2C;" text="Gatunek" />
                        <TableColumn fx:id="s_year" prefWidth="150" style="-fx-text-fill: #2C2C2C;" text="Rok wydania" />
                        <TableColumn fx:id="s_status" prefWidth="150" style="-fx-text-fill: #2C2C2C;" text="Status" />
                        <TableColumn fx:id="s_select" minWidth="2.0" prefWidth="48.0" style="-fx-text-fill: #2C2C2C;" text="" />
                    </columns>
                </TableView>
                <VBox alignment="BOTTOM_RIGHT" spacing="30">
                    <Button fx:id="borrow_button" onAction="#borrow" style="-fx-font-size: 16px; -fx-background-radius: 20px; -fx-border-radius: 20px;                        -fx-background-color: #2C2C2C; -fx-text-fill: #F5F5F5" text="Wypożycz książkę" />
                    <Button fx:id="add_button" onAction="#add_book" style="-fx-font-size: 16px; -fx-background-radius: 20px; -fx-border-radius: 20px;                        -fx-background-color: #2C2C2C; -fx-text-fill: #F5F5F5" text="Dodaj książke" />
                    <Button fx:id="delete_button" onAction="#delete_book" style="-fx-font-size: 16px; -fx-background-radius: 20px; -fx-border-radius: 20px;                        -fx-background-color: #2C2C2C; -fx-text-fill: #F5F5F5" text="Usuń książki" />
                </VBox>
            </HBox>
        </Tab>

        <Tab style="-fx-background-color: #2C2C2C; -fx-text-base-color: #F5F5F5;" text="Wypożyczenia">
            <VBox alignment="CENTER" spacing="30">
                <TableView fx:id="borrowTable" prefHeight="1300.0" prefWidth="1500.0" style="-fx-background-color: #726C6C; -fx-text-fill: #F5F5F5; -fx-table-cell-border-color: #2C2C2C">
                    <columns>
                        <TableColumn fx:id="b_id" prefWidth="100" style="-fx-text-fill: #2C2C2C;" text="ID" />
                        <TableColumn fx:id="b_person" prefWidth="377" style="-fx-text-fill: #2C2C2C;" text="Osoba" />
                        <TableColumn fx:id="b_title" prefWidth="377" style="-fx-text-fill: #2C2C2C;" text="Tutuł" />
                        <TableColumn fx:id="b_autor" prefWidth="277" style="-fx-text-fill: #2C2C2C;" text="Autor" />
                        <TableColumn fx:id="borrow_date" prefWidth="377" style="-fx-text-fill: #2C2C2C;" text="Data wypożyczenia" />
                        <TableColumn fx:id="return_date" prefWidth="377" style="-fx-text-fill: #2C2C2C;" text="Data oddania" />
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <Tab style="-fx-background-color: #2C2C2C; -fx-text-base-color: #F5F5F5;" text="Kary">
            <HBox alignment="CENTER" spacing="10">
                <TableView fx:id="penaltyTable" prefHeight="971.0" prefWidth="1914.0" style="-fx-background-color: #726C6C; -fx-text-fill: #F5F5F5; -fx-table-cell-border-color: #2C2C2C">
                    <columns>
                        <TableColumn fx:id="p_id" prefWidth="131.0" style="-fx-text-fill: #2C2C2C;" text="ID kary" />
                        <TableColumn fx:id="p_userid" prefWidth="168.0" style="-fx-text-fill: #2C2C2C;" text="ID użytkownika" />
                        <TableColumn fx:id="p_title" prefWidth="540.0" style="-fx-text-fill: #2C2C2C;" text="Tytuł" />
                        <TableColumn fx:id="p_autor" prefWidth="273.0" style="-fx-text-fill: #2C2C2C;" text="Autor" />
                        <TableColumn fx:id="p_return_date" prefWidth="266.0" style="-fx-text-fill: #2C2C2C;" text="Termin oddania" />
                        <TableColumn fx:id="p_value" prefWidth="231.0" style="-fx-text-fill: #2C2C2C;" text="Wartość kary" />
                        <TableColumn fx:id="p_status" prefWidth="307.0" style="-fx-text-fill: #2C2C2C;" text="Opłacono" />
                    </columns>
                </TableView>
            </HBox>
        </Tab>

        <Tab style="-fx-background-color: #2C2C2C; -fx-text-base-color: #F5F5F5;" text="Użytkownicy">
            <VBox alignment="TOP_CENTER" spacing="30">
                <TableView fx:id="userTable" prefHeight="1200.0" prefWidth="900.0" style="-fx-background-color: #726C6C; -fx-text-fill: #F5F5F5; -fx-table-cell-border-color: #2C2C2C">
                    <columns>
                        <TableColumn fx:id="u_id" prefWidth="269" style="-fx-text-fill: #2C2C2C;" text="ID" />
                        <TableColumn fx:id="u_name" prefWidth="270" style="-fx-text-fill: #2C2C2C;" text="Imię" />
                        <TableColumn fx:id="u_surname" prefWidth="270" style="-fx-text-fill: #2C2C2C;" text="Nazwisko" />
                        <TableColumn fx:id="u_login" prefWidth="269" style="-fx-text-fill: #2C2C2C;" text="Login" />
                        <TableColumn fx:id="u_password" prefWidth="269" style="-fx-text-fill: #2C2C2C;" text="Hasło?" />
                        <TableColumn fx:id="u_value" prefWidth="269" style="-fx-text-fill: #2C2C2C;" text="Wartość kary" />
                        <TableColumn fx:id="u_status" prefWidth="269" style="-fx-text-fill: #2C2C2C;" text="Status" />
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <Tab style="-fx-background-color: #2C2C2C; -fx-text-base-color: #F5F5F5;" text="Ustawienia konta">
            <VBox alignment="TOP_CENTER" spacing="10" style="-fx-padding: 20;">
                <Region prefHeight="0" />
                <HBox spacing="50">
                    <VBox alignment="CENTER_LEFT" spacing="5">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: #F5F5F5" text="Imię" />
                        <TextField fx:id="admin_name" prefWidth="300" style="-fx-font-size: 16px;" />
                    </VBox>
                    <VBox alignment="CENTER_LEFT" spacing="5">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: #F5F5F5" text="Nazwisko" />
                        <TextField fx:id="admin_surname" prefWidth="300" style="-fx-font-size: 16px;" />
                    </VBox>
                </HBox>

                <Region prefHeight="20" />

                <VBox alignment="CENTER_LEFT" spacing="5">
                    <Label style="-fx-font-size: 16px; -fx-text-fill: #F5F5F5" text="Data urodzenia" />
                    <DatePicker fx:id="admin_date" prefWidth="600" style="-fx-font-size: 16px;" />
                </VBox>

                <Region prefHeight="20" />

                <HBox alignment="CENTER_LEFT" spacing="5">
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: #F5F5F5" text="E-Mail" />
                        <TextField fx:id="admin_email" prefWidth="800" style="-fx-font-size: 16px;" />
                    </VBox>
                </HBox>

                <Region prefHeight="20" />

                <HBox alignment="CENTER_LEFT" spacing="5">
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: #F5F5F5" text="Login" />
                        <TextField fx:id="admin_login" prefWidth="800" style="-fx-font-size: 16px;" />
                    </VBox>
                </HBox>

                <Region prefHeight="20" />

                <HBox alignment="CENTER_LEFT" spacing="5">
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 16px; -fx-text-fill: #F5F5F5" text="Hasło" />
                        <PasswordField fx:id="admin_password" prefWidth="800" style="-fx-font-size: 16px;" />
                    </VBox>
                </HBox>
                <Region prefHeight="20" />
                <HBox spacing="10">
                    <Button fx:id="save_button" onAction="#save" style="-fx-font-size: 16px; -fx-background-radius: 20px; -fx-border-radius: 20px;                        -fx-background-color: #2C2C2C; -fx-text-fill: #F5F5F5" text="Zapisz zmiany" />
                    <Region prefHeight="20" />
                    <Button fx:id="del_button" onAction="#delete_acc" style="-fx-font-size: 16px; -fx-background-radius: 20px; -fx-border-radius: 20px;                        -fx-background-color: #2C2C2C; -fx-text-fill: #F5F5F5" text="Usuń konto" />
                </HBox>
            </VBox>
        </Tab>
    </TabPane>

    <Button fx:id="logg_button" layoutX="1810" layoutY="2" onAction="#logout" style="-fx-font-size: 12px; -fx-background-radius: 10px; -fx-border-radius: 10px;                    -fx-background-color: #2C2C2C; -fx-text-fill: #F5F5F5" text="Wyloguj się" />
</AnchorPane>
